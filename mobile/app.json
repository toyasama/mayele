{
  "expo": {
    "name": "Mayele Maths",
    "slug": "mayele",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/mayele-icon.png",
    "scheme": "mayele",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/mayele-icon.png",
      "bundleIdentifier": "com.mayele.maths",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Mayele se connecte au serveur de développement présent sur votre réseau local.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "com.mayele.maths",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/mayele-logo.png",
          "imageWidth": 76
        }
      ],
      "@clerk/expo",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1dbf42ae-453a-4f1d-a5f6-c3316bcdecac"
      }
    },
    "owner": "yremes"
  }
}
