{
  "name": "mayele-mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@clerk/expo": "3.4.2",
    "@expo/vector-icons": "^15.0.3",
    "expo": "~54.0.36",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-font": "~14.0.12",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.11",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~10.0.0",
    "typescript": "~5.9.2",
    "vitest": "^3.2.4"
  },
  "scripts": {
    "start": "expo start --dev-client --lan",
    "start:clear": "expo start --dev-client --lan --clear",
    "start:tunnel": "expo start --dev-client --tunnel",
    "start:go": "expo start --go --lan",
    "start:go:clear": "expo start --go --lan --clear",
    "start:go:tunnel": "expo start --go --tunnel",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:ios:development": "eas build --profile development --platform ios",
    "build:ios:production": "eas build --profile production --platform ios",
    "submit:ios": "eas submit --platform ios"
  },
  "private": true
}
