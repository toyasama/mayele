# Server
NODE_ENV=development
PORT=4000

# Clerk
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# Neon/Postgres
# Local development should use the Neon `dev` branch.
# Railway production should use the Neon `production` branch.
DATABASE_URL=postgresql://user:password@host/db?sslmode=verify-full
DIRECT_URL=postgresql://user:password@host/db?sslmode=verify-full

# Keep false with the single Railway replica in railway.json. Set true only
# when running multiple API replicas that need cross-process Socket.IO events.
REALTIME_POSTGRES_ADAPTER_ENABLED=false

# Error monitoring (required in production)
SENTRY_DSN=https://public-key@organization.ingest.sentry.io/project-id

# Comma-separated frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173
