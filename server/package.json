{
  "name": "server",
  "version": "1.0.0",
  "description": "API production pour Mayele Maths",
  "main": "dist/server.js",
  "scripts": {
    "dev": "npm run prisma:generate && tsx watch --exclude src/generated/** src/server.ts",
    "dev:e2e": "node scripts/dev-e2e.mjs",
    "build": "npm run prisma:generate && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "npm run prisma:generate && tsc --noEmit -p tsconfig.json",
    "test": "npm run prisma:generate && vitest run",
    "check:production-env": "tsx scripts/check-production-env.ts",
    "prisma:generate": "prisma generate",
    "db:check-domain": "node scripts/check-domain-constraints.mjs",
    "db:verify-ledger": "tsx scripts/verify-xp-ledger.ts",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@clerk/backend": "^3.15.0",
    "@clerk/express": "^2.1.30",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@sentry/node": "^10.65.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "pg": "^8.22.0",
    "prisma": "^7.8.0",
    "socket.io": "^4.8.3",
    "zod": "^4.4.3"
  },
  "overrides": {
    "@hono/node-server": "1.19.13"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-rate-limit": "^5.1.3",
    "@types/node": "^26.0.0",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "nodemon": "^3.1.14",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
