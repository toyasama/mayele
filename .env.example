# Server
NODE_ENV=development
PORT=4000

# Clerk
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
# Identifiants Clerk autorises a ouvrir /administration (separes par des virgules)
ADMIN_CLERK_USER_IDS=user_xxx

# Neon/Postgres
DATABASE_URL=postgresql://user:password@host/db?sslmode=verify-full
DIRECT_URL=postgresql://user:password@host/db?sslmode=verify-full

# Error monitoring (required in production)
SENTRY_DSN=https://public-key@organization.ingest.sentry.io/project-id

# CORS
CORS_ORIGINS=http://localhost:5173
