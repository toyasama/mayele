{
  "name": "client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "serve:e2e": "node scripts/serve-e2e.mjs",
    "check:runtime-config": "node scripts/check-runtime-config.mjs",
    "check:release-config": "node scripts/check-runtime-config.mjs --release",
    "build": "npm run check:runtime-config && tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:performance": "playwright test --config=playwright.performance.config.ts",
    "test:responsive": "playwright test --config=playwright.responsive.config.ts",
    "test:visual": "playwright test --config=playwright.visual.config.ts",
    "test:visual-v5": "playwright test --config=playwright.visual-v5.config.ts",
    "test:production-smoke": "node scripts/production-smoke.mjs"
  },
  "dependencies": {
    "@clerk/react": "^6.10.4",
    "@sentry/react": "^10.65.0",
    "@vercel/analytics": "^2.0.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.14.0",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^29.1.1",
    "playwright-core": "^1.61.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1",
    "vitest": "^4.1.7"
  }
}
